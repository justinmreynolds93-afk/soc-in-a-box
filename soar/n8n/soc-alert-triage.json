{
  "name": "SOC Alert Triage",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "soc-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000001",
      "name": "Kibana Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "soc-alert"
    },
    {
      "parameters": {
        "jsCode": "// Normalise a Kibana detection alert into a flat triage object.\nconst a = $input.first().json.body ?? $input.first().json;\nconst g = (o, p) => p.split('.').reduce((x, k) => (x == null ? x : x[k]), o);\nconst first = (v) => Array.isArray(v) ? v[0] : v;\nreturn [{ json: {\n  rule:      a['kibana.alert.rule.name'] || g(a, 'kibana.alert.rule.name') || a.rule?.name,\n  severity:  a['kibana.alert.severity']  || a.rule?.severity || 'low',\n  risk:      Number(a['kibana.alert.risk_score'] || a.rule?.risk_score || 0),\n  host:      first(a['host.name'] || g(a, 'host.name')) || 'unknown',\n  user:      first(a['user.name'] || g(a, 'user.name')) || null,\n  sourceIp:  first(a['source.ip'] || g(a, 'source.ip')) || null,\n  destIp:    first(a['destination.ip'] || g(a, 'destination.ip')) || null,\n  hashes:    a['file.hash.sha256'] || [],\n  timestamp: a['@timestamp'] || new Date().toISOString(),\n  raw:       a\n}}];"
      },
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "Parse Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.abuseipdb.com/api/v2/check?ipAddress={{ $json.sourceIp }}&maxAgeInDays=90",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Key", "value": "={{ $env.ABUSEIPDB_API_KEY }}" },
          { "name": "Accept", "value": "application/json" }
        ] },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "a1000000-0000-0000-0000-000000000003",
      "name": "Enrich source.ip (AbuseIPDB)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const alert = $('Parse Alert').first().json;\nconst abuse = $input.first().json?.data ?? {};\nconst score = Number(abuse.abuseConfidenceScore || 0);\nconst sevRank = { low: 1, medium: 2, high: 3, critical: 4 }[alert.severity] || 1;\nconst escalate = sevRank >= 3 || score >= 50 || alert.risk >= 70;\nreturn [{ json: { ...alert, abuseScore: score, abuseCountry: abuse.countryCode || null, escalate } }];"
      },
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            { "leftValue": "={{ $json.escalate }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        }
      },
      "id": "a1000000-0000-0000-0000-000000000005",
      "name": "Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":rotating_light: *{{ $json.rule }}* on `{{ $json.host }}`\\nseverity `{{ $json.severity }}` · risk {{ $json.risk }} · source `{{ $json.sourceIp }}` (AbuseIPDB {{ $json.abuseScore }})\\nuser `{{ $json.user }}` · {{ $json.timestamp }}\"\n}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "a1000000-0000-0000-0000-000000000006",
      "name": "Slack: page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, -120],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KIBANA_URL }}/api/cases",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "kbn-xsrf", "value": "n8n" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"{{ $json.rule }} — {{ $json.host }}\",\n  \"description\": \"Auto-opened by n8n. source.ip {{ $json.sourceIp }} (AbuseIPDB {{ $json.abuseScore }}, {{ $json.abuseCountry }}). user {{ $json.user }}. risk {{ $json.risk }}.\",\n  \"tags\": [\"soc-in-a-box\", \"auto\"],\n  \"severity\": \"{{ $json.severity == 'critical' ? 'critical' : ($json.severity == 'high' ? 'high' : 'medium') }}\",\n  \"connector\": { \"id\": \"none\", \"name\": \"none\", \"type\": \".none\", \"fields\": null },\n  \"settings\": { \"syncAlerts\": false },\n  \"owner\": \"securitySolution\"\n}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "a1000000-0000-0000-0000-000000000007",
      "name": "Kibana: open case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":information_source: {{ $json.rule }} on `{{ $json.host }}` (severity {{ $json.severity }}) — logged, no page.\"\n}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "a1000000-0000-0000-0000-000000000008",
      "name": "Slack: note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Kibana Alert Webhook": { "main": [[{ "node": "Parse Alert", "type": "main", "index": 0 }]] },
    "Parse Alert": { "main": [[{ "node": "Enrich source.ip (AbuseIPDB)", "type": "main", "index": 0 }]] },
    "Enrich source.ip (AbuseIPDB)": { "main": [[{ "node": "Decide", "type": "main", "index": 0 }]] },
    "Decide": { "main": [[{ "node": "Escalate?", "type": "main", "index": 0 }]] },
    "Escalate?": {
      "main": [
        [{ "node": "Slack: page", "type": "main", "index": 0 }, { "node": "Kibana: open case", "type": "main", "index": 0 }],
        [{ "node": "Slack: note", "type": "main", "index": 0 }]
      ]
    }
  }
}
