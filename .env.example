# Copy to .env and edit. .env is gitignored.
# ─── Compose ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=soc-in-a-box

# ─── Elastic Stack ────────────────────────────────────────────────────────────
# TODO(M1): confirm the latest 8.x release before first bring-up.
# https://www.elastic.co/downloads/past-releases#elasticsearch — 9.x is untested here.
STACK_VERSION=8.17.3
CLUSTER_NAME=soc-in-a-box
LICENSE=basic

# Passwords — CHANGE BOTH before `make up`. Min 8 chars. Avoid $ " ' to keep Compose happy.
ELASTIC_PASSWORD=changeme_elastic_pw
KIBANA_PASSWORD=changeme_kibana_pw

# Host-side ports
ES_PORT=9200
KIBANA_PORT=5601
FLEET_SERVER_PORT=8220

# Resource caps — tuned for a 16 GB host. Raise if you have headroom.
ES_JAVA_OPTS=-Xms2g -Xmx2g
ES_MEM_LIMIT=3758096384       # 3.5 GB
KIBANA_MEM_LIMIT=1610612736   # 1.5 GB
FLEET_MEM_LIMIT=1073741824    # 1.0 GB

# ─── Enrichment APIs (M6 · SOAR) ──────────────────────────────────────────────
# All optional. Blank = that enrichment step is skipped. Free tiers are sufficient.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=

# ─── Notifications (M6) ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
