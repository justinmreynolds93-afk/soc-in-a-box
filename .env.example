# Copy to .env and edit (or run scripts/bootstrap.ps1, which generates one).
# .env is gitignored.

# ─── Compose ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=soc-in-a-box

# ─── Elastic Stack ────────────────────────────────────────────────────────────
# Latest 8.x as of 2026-09. 9.x is untested against this lab.
# https://www.elastic.co/downloads/past-releases
STACK_VERSION=8.19.20
CLUSTER_NAME=soc-in-a-box
LICENSE=basic

# Credentials — CHANGE ALL THREE. Alphanumeric only (Elasticsearch rejects symbols
# in the bootstrap password). bootstrap.ps1 fills these with random 24-char values.
ELASTIC_PASSWORD=changeme_elastic_pw
KIBANA_PASSWORD=changeme_kibana_pw
ENCRYPTION_KEY=changeme_32_char_min_kibana_saved_objects_key

# Host-side ports
ES_PORT=9200
KIBANA_PORT=5601
FLEET_SERVER_PORT=8220

# Fleet enrollment tokens — populated by scripts/setup-fleet.ps1 (M2), not by hand.
LINUX_ENROLLMENT_TOKEN=
WINDOWS_ENROLLMENT_TOKEN=

# Resource caps. Sized for Docker Desktop set to 8 GB (Settings > Resources).
# If you give Docker 12 GB+, bump ES_JAVA_OPTS to -Xms2g -Xmx2g and ES_MEM_LIMIT to 4 GB.
ES_JAVA_OPTS=-Xms1536m -Xmx1536m
ES_MEM_LIMIT=3221225472       # 3.0 GB
KIBANA_MEM_LIMIT=1610612736   # 1.5 GB

# ─── Enrichment APIs (M6 · SOAR) ──────────────────────────────────────────────
# Optional. Blank = that enrichment step is skipped. Free tiers are sufficient.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=

# ─── Notifications (M6) ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
